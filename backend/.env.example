# Copy to backend/.env and fill in. Never commit the real file.
# URL and anon key are read from ../.env (VITE_*) if not set here.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<public anon key>

# Required for real security: Supabase Dashboard > Project Settings > API > service_role.
# Keep this on the server only. Without it the backend uses the anon key.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001
# Production: set to your site, e.g. https://medic.example.com
CORS_ORIGIN=*
